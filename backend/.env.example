# ═══════════════════════════════════════════════════════════════════
# RHoSAM Supermarket Backend — Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://username:password@localhost:5432/rhosam_db

# ── Authentication ───────────────────────────────────────────────
# Secret key for JWT token signing (required — use a long random string)
JWT_SECRET=your-super-secret-random-key-change-this-in-production

# ── Server ───────────────────────────────────────────────────────
# Port the backend server listens on (default: 5000)
PORT=5000

# ── CORS ─────────────────────────────────────────────────────────
# Allowed frontend origin (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ── Security ─────────────────────────────────────────────────────
# Max failed login attempts before account lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Minutes to lock account after max failed attempts (default: 15)
LOCK_MINUTES=15

# ── Email (Resend) ──────────────────────────────────────────────
# Resend API key for sending daily report emails (optional)
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# ── Cloud Storage (Cloudinary) ─────────────────────────────────
# Cloudinary for persistent product image storage (optional)
# Without this, images are stored locally (lost on Render redeploy)
# Get yours at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
