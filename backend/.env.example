# ═══════════════════════════════════════════════════════════════════
# RHoSAM Supermarket Backend — Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://username:password@localhost:5432/rhosam_db

# ── Authentication ───────────────────────────────────────────────
# Secret key for JWT token signing (required — use a long random string)
JWT_SECRET=your-super-secret-random-key-change-this-in-production

# ── Server ───────────────────────────────────────────────────────
# Port the backend server listens on (default: 5000)
PORT=5000

# ── CORS ─────────────────────────────────────────────────────────
# Allowed frontend origin (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ── Security ─────────────────────────────────────────────────────
# Max failed login attempts before account lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Minutes to lock account after max failed attempts (default: 15)
LOCK_MINUTES=15

# ── Email (Resend) ──────────────────────────────────────────────
# Resend API key for sending email notifications (optional)
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email sender address (optional, defaults to Resend sandbox)
EMAIL_FROM=RHoSAM <noreply@yourdomain.com>

# ── SMS (Telnyx) ──────────────────────────────────────────────
# Telnyx API key for SMS notifications (optional)
# Get yours at https://portal.telnyx.com/#/api-keys
TELNYX_API_KEY=your_telnyx_api_key_here

# Telnyx phone number or sender ID for outbound SMS
TELNYX_PHONE_NUMBER=+2348000000000

# ── Cloud Storage (Cloudinary) ─────────────────────────────────
# Cloudinary for persistent product image storage (optional)
# Without this, images are stored locally (lost on Render redeploy)
# Get yours at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Payment Gateway ────────────────────────────────────────────
# Which gateway to use: PAYSTACK or FLUTTERWAVE (default: INTERNAL for cash-only)
PAYMENT_GATEWAY=PAYSTACK

# Paystack secret key (required if PAYMENT_GATEWAY=PAYSTACK)
# Get yours at https://dashboard.paystack.com/#/settings/keys
PAYSTACK_SECRET_KEY=replace_with_your_paystack_secret_key

# Paystack public key (for frontend initialization)
PAYSTACK_PUBLIC_KEY=replace_with_your_paystack_public_key

# Flutterwave secret key (required if PAYMENT_GATEWAY=FLUTTERWAVE)
# Get yours at https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_SECRET_KEY=replace_with_your_flutterwave_secret_key

# Flutterwave public key (for frontend initialization)
FLUTTERWAVE_PUBLIC_KEY=replace_with_your_flutterwave_public_key

# Webhook secret for verifying gateway callbacks (optional but recommended)
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here
